# Default runner mappings for local act runs.
-P ubuntu-latest=catthehacker/ubuntu:act-latest
-P ubuntu-24.04=catthehacker/ubuntu:act-latest
-P ubuntu-24.04-arm=catthehacker/ubuntu:act-latest
-P ubuntu-22.04=catthehacker/ubuntu:act-22.04
-P macos-latest=catthehacker/ubuntu:act-latest
-P macos-15=catthehacker/ubuntu:act-latest
-P macos-15-intel=catthehacker/ubuntu:act-latest
-P macos-13=catthehacker/ubuntu:act-latest
-P windows-2022=catthehacker/ubuntu:act-latest
-P windows-11-arm=catthehacker/ubuntu:act-latest

# Architecture: omitted → native (arm64 on Apple Silicon).
# Workflows needing amd64 (compatibility-check) pass it explicitly:
#   act -W ... --container-architecture linux/amd64
--artifact-server-path /tmp/act-artifacts
--artifact-server-addr 192.168.64.1
--container-daemon-socket -

# To enable pipelines 02/03/04 (which download CI artifacts):
#   1. Copy .act.secrets.example to .act.secrets
#   2. Fill in GITHUB_TOKEN (needs repo scope — run: gh auth token)
#   3. Uncomment the line below:
--secret-file .act.secrets
