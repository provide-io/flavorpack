{
  "name": "pretaster",
  "version": "1.0.0",
  "description": "Pretaster shell implementation test",
  "command": "/bin/bash {workenv}/scripts/taster_lite.sh",
  "environment": {
    "TASTER_MODE": "lite"
  },
  "package": {
    "name": "pretaster",
    "version": "1.0.0",
    "description": "Pretaster shell implementation test"
  },
  "format": "PSPF/2025",
  "slots": [
    {
      "slot": 0,
      "name": "taster_lite.sh",
      "path": "scripts/taster_lite.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "encoding": "none",
      "extract_to": "{workenv}/scripts"
    }
  ],
  "runtime": {
    "env": {
      "unset": ["*"],
      "pass": ["PATH", "HOME", "USER", "LANG", "LC_*", "TERM", "SHELL", "FLAVOR_*"],
      "set": {
        "PRETASTER_VERSION": "1.0.0"
      }
    }
  },
  "execution": {
    "command": "/bin/bash {workenv}/scripts/taster_lite.sh",
    "args": [],
    "env": {
      "TASTER_MODE": "lite"
    },
    "primary_slot": 0
  }
}