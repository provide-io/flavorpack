{
  "name": "pretaster",
  "version": "1.0.0",
  "description": "Pretaster with embedded Taster for package building",
  "command": "/bin/bash {workenv}/pretaster",
  "environment": {
    "PRETASTER_MODE": "builder"
  },
  "package": {
    "name": "pretaster",
    "version": "1.0.0",
    "description": "Pretaster test suite with package building capability"
  },
  "format": "PSPF/2025",
  "slots": [
    {
      "slot": 0,
      "name": "pretaster",
      "path": "{workenv}/scripts/pretaster",
      "purpose": "payload",
      "lifecycle": "cached",
      "encoding": "none"
    },
    {
      "slot": 1,
      "name": "test-with-taster.sh",
      "path": "{workenv}/scripts/test-with-taster.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "encoding": "none"
    },
    {
      "slot": 2,
      "name": "taster.psp",
      "path": "{workenv}/taster/taster.psp",
      "purpose": "payload",
      "lifecycle": "cached",
      "encoding": "none"
    }
  ],
  "runtime": {
    "env": {
      "unset": ["*"],
      "pass": ["PATH", "HOME", "USER", "LANG", "LC_*", "TERM", "SHELL", "FLAVOR_*", "FLAVOR_LOG_LEVEL"],
      "set": {
        "PRETASTER_VERSION": "1.0.0",
        "BUNDLED_TASTER": "{workenv}/taster.psp"
      }
    }
  },
  "execution": {
    "command": "/bin/bash {workenv}/pretaster",
    "args": [],
    "env": {
      "PRETASTER_MODE": "builder",
      "BUNDLED_TASTER": "{workenv}/bin/taster.psp"
    },
    "primary_slot": 0
  }
}