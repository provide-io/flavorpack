# Environment
.env
.venv
venv/
env/
# Project workenv directory (but not Rust source directories)
/workenv/
# Allow Rust workenv source modules
!src/*/src/workenv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Distribution
build/
*.egg-info/
*.egg
.eggs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
reports/

# IDE
.idea/
.vscode/
.worktree/
.worktrees/

# Local Build Artifacts
# Compiled helper binaries should not be version controlled.
# They are built from source via `./build.sh`.
dist/
*.pspf
*.psp
target/
*code.sh

# ...except the format-compatibility fixtures, which are committed on purpose.
# They are packages built by an older toolchain and are the only check that new
# code still verifies old packages. See tests/fixtures/format_compat/README.md.
!tests/fixtures/format_compat/**/*.psp

# Test manifests (generated during testing)
flavor-manifest.json
tests/pretaster/pretaster-build-manifest.json
tests/pretaster/test-runner.sh
tests/pretaster/**/*.tar.gz
*bfile*
.hypothesis
*.whl
# Build artifacts and binaries (but not Rust src/bin/ source directories)
/bin/
dist/bin/
**/target/**/bin/
# Allow Rust source directories
!src/*/src/bin/
# Go build artifacts in source tree (go build produces binaries in module root)
src/flavor-go/flavor-go-*
core
*.local.json
archive_*

# Mutation testing artifacts
mutants/
.mutmut-cache
html/

# Synced theme files (source: provide-foundry/shared-theme/)
docs/.shared-theme/

# MkDocs generated site
site/
bf-*.txt
*-bf.txt

# Local act secrets (never commit)
.act.secrets

# Wrangler (Cloudflare) local state
.wrangler/

# Memray profiling output
memray-output/

# Generated test artifacts
coverage.json
coverage.xml
src/flavor-go/coverage_*.out
src/flavor-go/coverage.out
src/flavor-go/coverage.txt
# Written by ci/license-check-rust.sh
src/flavor-rs/rust-licenses.json
src/flavor-rs/rust-licenses.txt
src/flavor-rs/cargo-deny-licenses.log
tests/pretaster/logs/
# Written by ci/run-tests.sh, ci/pr-tests.sh and ci/quality-checks.sh, which
# are worth running locally -- see the 03b notes in docs/development/ci-cd.md.
pytest-results.xml
test-report.json
test-logs/
test-metadata/
test-outputs/
quality-logs/
.claude/worktrees/
Users/

# Foundry docs-build tooling (injected by preflight; not versioned)
.provide/

# flavorpack generates a fresh signing keypair per build (see
# flavor/packaging/keys.py); nothing verifies against a committed one. They are
# build artifacts, and committing them is how private keys reached five public
# repositories in this suite.
keys/
*.private-key.pem

# Compiled output. These were committed once and purged from history; the
# repository carried ~150MB of them across 14 versions of the Go launcher alone.
# Build them, do not track them.
src/flavor-go/flavor-go-launcher
src/flavor-go/flavor-go-builder
src/flavor-go/main
src/flavor-go/*.test
src/flavor-go/pretaster-psp-*/
src/ingredients/bin/
tests/pretaster/failure-diagnostics/

# cargo-mutants writes its run into the crate directory
src/flavor-rs/.cargo-mutants.out/

# Scratch file listings
flavor-bfiles.txt
bfiles-*.txt
