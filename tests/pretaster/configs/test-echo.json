{
  "name": "pretaster-echo",
  "version": "1.0.0",
  "description": "Simple echo test with embedded tastesh — no host dependencies",
  "package": {
    "name": "pretaster-echo",
    "version": "1.0.0",
    "description": "Simple echo test with embedded tastesh"
  },
  "format": "PSPF/2025",
  "slots": [
    {
      "slot": 0,
      "id": "tastesh",
      "source": "TASTESH_BIN",
      "target": "bin/tastesh",
      "purpose": "tool",
      "lifecycle": "runtime",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    },
    {
      "slot": 1,
      "id": "echo-test-script",
      "source": "scripts/echo_test.sh",
      "target": "scripts/echo_test.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    }
  ],
  "execution": {
    "command": "{workenv}/bin/tastesh {workenv}/scripts/echo_test.sh",
    "args": [],
    "env": {},
    "primary_slot": 1
  }
}
