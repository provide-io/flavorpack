{
  "name": "pretaster-policy-warn",
  "version": "1.0.0",
  "description": "Tests that enforcement mode 'warn' logs but allows execution",
  "package": {
    "name": "pretaster-policy-warn",
    "version": "1.0.0",
    "description": "Tests that enforcement mode 'warn' logs but allows execution"
  },
  "policy": {
    "platforms": ["mars_amd64"]
  },
  "format": "PSPF/2025",
  "slots": [
    {
      "slot": 0,
      "id": "tastesh",
      "source": "TASTESH_BIN",
      "target": "bin/tastesh",
      "purpose": "tool",
      "lifecycle": "runtime",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    },
    {
      "slot": 1,
      "id": "policy-warn-test-script",
      "source": "scripts/policy_test.sh",
      "target": "scripts/policy_test.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    }
  ],
  "execution": {
    "command": "{workenv}/bin/tastesh {workenv}/scripts/policy_test.sh",
    "args": [],
    "env": {},
    "primary_slot": 1
  }
}
