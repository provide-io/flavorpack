{
  "name": "pretaster-echo-sh",
  "version": "1.0.0",
  "description": "Echo test with embedded dash shell — no host dependencies",
  "package": {
    "name": "pretaster-echo-sh",
    "version": "1.0.0",
    "description": "Echo test with embedded dash shell"
  },
  "execution": {
    "command": "{workenv}/bin/sh {workenv}/scripts/echo_test.sh",
    "args": [],
    "env": {},
    "primary_slot": 1
  },
  "slots": [
    {
      "slot": 0,
      "id": "dash-shell",
      "source": "DASH_BIN_PLACEHOLDER",
      "target": "bin/sh",
      "purpose": "tool",
      "lifecycle": "runtime",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    },
    {
      "slot": 1,
      "id": "echo-test-script",
      "source": "scripts/echo_test.sh",
      "target": "scripts/echo_test.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    }
  ]
}
