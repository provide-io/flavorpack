{
  "name": "pretaster-env",
  "version": "1.0.0",
  "description": "Environment variable filtering test with embedded tastesh",
  "package": {
    "name": "pretaster-env",
    "version": "1.0.0",
    "description": "Environment variable filtering test with embedded tastesh"
  },
  "format": "PSPF/2025",
  "slots": [
    {
      "slot": 0,
      "id": "tastesh",
      "source": "TASTESH_BIN",
      "target": "bin/tastesh",
      "purpose": "tool",
      "lifecycle": "runtime",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    },
    {
      "slot": 1,
      "id": "env-test-script",
      "source": "scripts/env_test.sh",
      "target": "scripts/env_test.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    }
  ],
  "runtime": {
    "env": {
      "unset": ["*"],
      "pass": ["PATH", "HOME", "USER", "LANG", "LC_*", "TERM", "FLAVOR_*"],
      "set": {
        "PRETASTER_MODE": "env_test"
      }
    }
  },
  "execution": {
    "command": "{workenv}/bin/tastesh {workenv}/scripts/env_test.sh",
    "args": [],
    "env": {},
    "primary_slot": 1
  }
}
