{
  "name": "pretaster-shell",
  "version": "1.0.0",
  "description": "Shell script test with embedded tastesh",
  "package": {
    "name": "pretaster-shell",
    "version": "1.0.0",
    "description": "Shell script test with embedded tastesh"
  },
  "format": "PSPF/2025",
  "slots": [
    {
      "slot": 0,
      "id": "tastesh",
      "source": "TASTESH_BIN",
      "target": "bin/tastesh",
      "purpose": "tool",
      "lifecycle": "runtime",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    },
    {
      "slot": 1,
      "id": "shell-test-script",
      "source": "scripts/simple_test.sh",
      "target": "scripts/simple_test.sh",
      "purpose": "payload",
      "lifecycle": "cached",
      "operations": "raw",
      "permissions": "0755",
      "resolution": "build"
    }
  ],
  "execution": {
    "command": "{workenv}/bin/tastesh {workenv}/scripts/simple_test.sh",
    "args": [],
    "env": {
      "TEST_MODE": "pretaster"
    },
    "primary_slot": 1
  }
}
