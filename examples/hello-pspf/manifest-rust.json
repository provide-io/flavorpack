{
  "name": "hello-pspf",
  "version": "1.0.0",
  "description": "Simple PSPF 2025 test application",
  "launcher": "rust",
  "command": "python3 {slot:0}",
  "environment": {
    "PSPF_VERSION": "2025",
    "PSPF_SLOT_PATH": "{slot:0}"
  },
  "slots": [
    {
      "path": "examples/hello-pspf/main.py",
      "name": "main.py",
      "compression": "gzip",
      "purpose": "payload",
      "lifecycle": "persistent"
    }
  ]
}