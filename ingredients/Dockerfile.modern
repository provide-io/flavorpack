# Dockerfile for building with latest toolchains
# Supports Rust edition 2024 and modern Go

FROM rust:1.85-alpine AS rust-builder

# Install build dependencies
RUN apk add --no-cache musl-dev gcc g++ make

WORKDIR /build

# Copy Rust project
COPY flavor-rs/ ./flavor-rs/

# Build with edition 2024 support
WORKDIR /build/flavor-rs
RUN cargo +nightly build --release --target x86_64-unknown-linux-musl && \
    cargo +nightly build --release --target aarch64-unknown-linux-musl || true

# Go builder stage
FROM golang:1.23-alpine AS go-builder

WORKDIR /build

# Copy Go project
COPY flavor-go/ ./flavor-go/

# Build Go binaries (static by default with CGO_ENABLED=0)
WORKDIR /build/flavor-go
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -buildvcs=false -o ../bin/flavor-go-builder-linux_amd64 ./cmd/flavor-go-builder && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -buildvcs=false -o ../bin/flavor-go-launcher-linux_amd64 ./cmd/flavor-go-launcher && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -buildvcs=false -o ../bin/flavor-go-builder-linux_arm64 ./cmd/flavor-go-builder && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -buildvcs=false -o ../bin/flavor-go-launcher-linux_arm64 ./cmd/flavor-go-launcher

# Final stage - collect all binaries
FROM alpine:latest

RUN apk add --no-cache file

WORKDIR /ingredients

# Copy all built binaries
COPY --from=rust-builder /build/flavor-rs/target/*/release/flavor-rs-* ./bin/
COPY --from=go-builder /build/bin/flavor-go-* ./bin/

# Verify binaries
RUN for binary in ./bin/*; do \
        echo "Checking $binary:"; \
        file "$binary"; \
        ldd "$binary" 2>/dev/null || echo "  Static binary (no dynamic dependencies)"; \
    done

CMD ["ls", "-la", "bin/"]