# Copy this file to .act.secrets and fill in your values.
# .act.secrets is gitignored — never commit it.
#
# Pass to act with: act --secret-file .act.secrets
# Or add to .actrc:  --secret-file .act.secrets
#
# Required for workflows 02, 03, 04 that download artifacts from prior CI runs:
#   GITHUB_TOKEN must have: repo scope (read artifacts, list workflow runs)
#   Run `gh auth token` to get your current token.
GITHUB_TOKEN=ghp_your_token_here
